# Headless smoke test config — copy to .env.smoke and fill in.
# .env.smoke is gitignored.

# Long-lived Stytch session token (JWT or opaque) for a dedicated test user.
# Get one by logging in as the test user and copying the cookie value:
#   document.cookie  →  stytch_session_jwt=... or stytch_session=...
SMOKE_STYTCH_TOKEN=

# profile.id of the test user (uuid). Find via:
#   SELECT id FROM profiles WHERE email = 'smoke@yourdomain' LIMIT 1;
SMOKE_USER_ID=

# Optional override — default is http://localhost:3000 (or prod with --prod).
# SMOKE_BASE=https://mulbros-marketing-os.onrender.com

# These are usually inherited from your shell or .env:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=
