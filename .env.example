# Client-side (Vite) — safe to expose in bundle
VITE_STYTCH_PUBLIC_TOKEN=public-token-test-xxxxxxxx
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
VITE_APP_URL=http://localhost:5173

# Admin email allowlist — comma-separated list of emails that see the "Admin"
# button on the onboarding screen. Clicking Admin sets profile.vertical='admin'
# which unlocks all 9 verticals in the sidebar.
# Case-insensitive. Leave blank to hide the Admin button entirely.
# Example: VITE_ADMIN_EMAILS=arghya@fsztpartners.com,sean@mulbros.com
VITE_ADMIN_EMAILS=

# Server-side — never prefix with VITE_
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
# Optional: override Apify Reddit scraper actor slug (default: trudax~reddit-scraper-lite)
# APIFY_REDDIT_ACTOR=trudax~reddit-scraper-lite
Resend_API=

# Spotify OAuth — for musician vertical real-stats integration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/api/spotify/callback

# Stytch backend SDK — REQUIRED for /api/email, /api/firecrawl-search, /api/apify-reddit
STYTCH_PROJECT_ID=project-test-xxxxxxxx
STYTCH_SECRET=secret-test-xxxxxxxx
STYTCH_ENV=test

# Supabase JWT secret — REQUIRED for /api/auth/supabase-token (Stytch -> Supabase bridge)
# From: Supabase Dashboard -> JWT Keys -> Legacy JWT Secret
SUPABASE_JWT_SECRET=

# ─── Sprint 4 Integrations ────────────────────────────────────────────────
# All integrations support mock mode — endpoints return mock responses if
# env vars below are missing. Set real values to activate.

# Mux video upload (self-tapes) — https://dashboard.mux.com → Settings → Access Tokens
# Required for /api/integrations/mux/upload-url
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Stripe Connect for commission payouts — https://dashboard.stripe.com/test/apikeys
# Use test mode key (sk_test_...) until live; required for /api/integrations/stripe/connect/onboard
STRIPE_SECRET_KEY=

# DocuSign contract signing — https://developers.docusign.com (use Demo environment first)
# DOCUSIGN_ACCESS_TOKEN is a bearer token (OAuth/JWT) — production needs JWT auth flow
# DOCUSIGN_BASE_URL: https://demo.docusign.net/restapi for sandbox · https://www.docusign.net/restapi for prod
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# Plaid US bank sync (talent income) — https://dashboard.plaid.com → Team Settings → Keys
# PLAID_ENV: sandbox | development | production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Twilio SMS — https://console.twilio.com → Account Info
# TWILIO_FROM_NUMBER must be a verified Twilio number in E.164 format (+1XXXXXXXXXX)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Deferred — require manual Google Cloud + paid account setup ─────────
# Gmail OAuth — Google Cloud Console → APIs → OAuth 2.0 Client (requires verified domain)
# Sprint 5 deliverable; not wired in Sprint 4.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# Google Calendar OAuth — same Google Cloud Console; same deferral as Gmail.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# Backstage casting feed — paid API access needed; no sandbox available.
# Sprint 5 deliverable when access confirmed by client.
# BACKSTAGE_API_KEY=

# Optional HTTP Basic Auth
# ADMIN_USER=
# ADMIN_PASS=
